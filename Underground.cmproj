game: magic
version: 1
defaultBackImage: games/magic/assets/back.png
title: "Magic: Underground"
author: ""
description: A core set with a re-imagined set of evergreen mechanics.
illustrator: ""
legalText: ""
setCode: UDG
language: EN
collectorNumberFormat: cardCodes
rarityOrder: before
symbol: |-
  <svg class="set-icon" viewBox="0 0 100 100" width="24" height="24" role="img">
      <defs>
          <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop class="g1" offset="0%" stop-color="black"/>
              <stop class="g2" offset="45%" stop-color="black"/>
              <stop class="g3" offset="55%" stop-color="black"/>
              <stop class="g4" offset="100%" stop-color="black"/>
          </linearGradient>
      </defs>

      <rect
          class="outer"
          x="20"
          y="20"
          width="60"
          height="60"
          rx="4"
          ry="4"
          fill="url(#grad)"
          stroke="var(--rar-stroke-outer)"
          stroke-width="5"
      />
  </svg>
export:
  CardImagesExporter:
    imageType: jpg
    quality: "0.92"
    scale: "2"
    bleed: "0"
  TTSExporter:
    basePath: https://cdn.jsdelivr.net/gh/matortheeternal/mtg-underground@master/dist/images
    ttsBasePath: https://cdn.jsdelivr.net/gh/matortheeternal/mtg-underground@master/dist/tts
  OldTTSExporter:
    basePath: https://cdn.jsdelivr.net/gh/matortheeternal/mtg-underground@master/dist/images
  WebExporter:
    Test: ""
    test: ""
    baseUrl: https://cdn.jsdelivr.net/gh/matortheeternal/mtg-underground@master
pack:
  - label: Commons
    count: "10"
    pool:
      - expression: r=c -t:land
        weight: 1
    collation: runs
  - label: Uncommons
    count: "4"
    pool:
      - expression: r=u -t:land
        weight: 1
    collation: runs
  - label: Rares and Mythics
    count: "0"
    pool:
      - expression: r=r -t:land
        weight: 1
      - expression: r=m -t:land
        weight: 1
    collation: sheet
  - label: Land
    count: 1
    pool:
      - expression: t:land r=c
        weight: "6"
      - expression: t:land r=u
        weight: "10"
      - expression: t:land r=r
        weight: "2"
      - expression: t:land r=m
        weight: "2"
    collation: sheet
imageExportPath: dist/images/
